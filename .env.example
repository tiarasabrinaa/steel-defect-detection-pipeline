# Copy file ini ke `.env` (jangan commit .env yang asli) lalu isi kredensial
# Databricks kamu. src/utils/mlflow_utils.py otomatis load .env ini.
#
# Cara dapat token: Databricks workspace -> User Settings -> Developer ->
# Access tokens -> Generate new token.

# "databricks" supaya MLflow ngirim tracking data ke Databricks Managed MLflow.
# Kosongkan (hapus baris ini) kalau mau tracking lokal ke ./mlruns dulu buat testing.
MLFLOW_TRACKING_URI=databricks

DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token>

# Base path folder MLflow experiment di workspace Databricks kamu, biasanya
# /Users/<email-databricks-kamu>/<nama-folder>. Tiap skenario training akan
# dibuat sebagai experiment terpisah di bawah path ini, misal:
#   <base_path>/steel-defect/classification/gc10
#   <base_path>/steel-defect/detection/combined
MLFLOW_EXPERIMENT_BASE_PATH=/Users/your-email@example.com/steel-defect-detection